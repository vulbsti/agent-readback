+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        (0, "0"),
+        (100, "100"),
+        (999, "999"),
+        (1_000, "1.0K"),
+        (12_400, "12.4K"),
+        ("12400", "12.4K"),
+        (1_200_000, "1.2M"),
+        (3_000_000_000, "3.0B"),
+        (7_100_000_000_000, "7.1T"),
+        # Rounding carry into the next suffix
+        (999_999, "1.0M"),
+        (999_999_999, "1.0B"),
+        (999_999_999_999, "1.0T"),
+        # Carry past trillion falls back to the word form
+        (999_999_999_999_999, "1.0 quadrillion"),
+        # Negative numbers
+        (-999, "-999"),
+        (-12_400, "-12.4K"),
+        (-1_200_000, "-1.2M"),
+        (-999_999, "-1.0M"),
+        (-7_100_000_000_000, "-7.1T"),
+        # Above trillion: word form
+        (10**15, "1.0 quadrillion"),
+        (-(10**18), "-1.0 quintillion"),
+        (2 * 10**100, "2.0 googol"),
+        # Non-numeric / non-finite values are unaffected
+        (None, "None"),
+        ("abc", "abc"),
+        (math.inf, "+Inf"),
+    ],
+)
+def test_intword_compact(value: object, expected: str) -> None:
+    assert humanize.intword(value, compact=True) == expected  # type: ignore[arg-type]
+
+
+def test_intword_compact_format() -> None:
+    assert humanize.intword(1_234_000, "%0.3f", compact=True) == "1.234M"
+    assert humanize.intword(999_499, "%.0f", compact=True) == "999K"
+    assert humanize.intword(999_500, "%.0f", compact=True) == "1M"
+
+
+def test_intword_compact_default_unchanged() -> None:
+    assert humanize.intword(12_400) == "12.4 thousand"
+    assert humanize.intword(12_400, compact=False) == "12.4 thousand"
+    assert humanize.intword(1_200_000) == "1.2 million"
+
+
