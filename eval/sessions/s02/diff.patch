+/**
+ * Decode supported HTML entities in the given string of text.
+ *
+ * @param  {string} string The string to unescape
+ * @return {string}
+ * @public
+ */
+
+function unescapeHtml (string) {
+  return ('' + string).replace(matchEntityRegExp, function (entity, decimal, hex) {
+    switch (entity) {
+      case '&quot;': return '"'
+      case '&amp;': return '&'
+      case '&lt;': return '<'
+      case '&gt;': return '>'
+    }
+
+    var codePoint = decimal ? parseInt(decimal, 10) : parseInt(hex, 16)
+
+    if (codePoint > 0x10FFFF || (codePoint >= 0xD800 && codePoint <= 0xDFFF)) {
+      return entity
+    }
+
+    if (codePoint <= 0xFFFF) {
+      return String.fromCharCode(codePoint)
+    }
+
+    codePoint -= 0x10000
+    return String.fromCharCode(0xD800 + (codePoint >> 10), 0xDC00 + (codePoint & 0x3FF))
+  })
+}
diff --git a/test/unescape.test.js b/test/unescape.test.js
new file mode 100644
index 0000000..f8dfbe8
--- /dev/null
+++ b/test/unescape.test.js
@@ -0,0 +1,65 @@
+'use strict'
+
+var test = require('node:test')
+var assert = require('node:assert')
+var escapeHtml = require('..')
+var unescape = escapeHtml.unescape
+
+test('exports unescape alongside the existing escapeHtml function', function () {
+  assert.strictEqual(typeof escapeHtml, 'function')
+  assert.strictEqual(typeof unescape, 'function')
+  assert.strictEqual(escapeHtml('<&>'), '&lt;&amp;&gt;')
+})
+
+test('decodes all entities emitted by escapeHtml', function () {
+  assert.strictEqual(unescape('&quot;&amp;&#39;&lt;&gt;'), '"&\'<>')
+  var original = 'Text "quoted" & <tag> with \'apostrophes\' and &lt;'
+  assert.strictEqual(unescape(escapeHtml(original)), original)
+})
+
+test('decodes decimal numeric references', function () {
+  assert.strictEqual(unescape('&#34;&#38;&#39;&#60;&#62;'), '"&\'<>')
+  assert.strictEqual(unescape('before &#00060; after &#65;'), 'before < after A')
+})
+
+test('decodes hexadecimal references with either x prefix and letter case', function () {
+  assert.strictEqual(unescape('&#x3C;&#X3c;&#x3e;&#X3E;&#x0027;'), '<<>>\'')
+})
+
+test('decodes supplementary characters and valid Unicode boundaries', function () {
+  assert.strictEqual(unescape('&#128512;&#x1F600;'), '\uD83D\uDE00\uD83D\uDE00')
+  assert.strictEqual(unescape('&#0;&#xD7FF;&#xE000;&#65535;&#x10000;&#1114111;'),
+    '\u0000\uD7FF\uE000\uFFFF\uD800\uDC00\uDBFF\uDFFF')
+})
+
+test('leaves invalid code points unchanged without throwing', function () {
+  var invalid = '&#x110000; &#1114112; &#xD800; &#55296; &#xDFFF; &#57343; ' +
+    '&#9999999999999999999999999999999999999999; &#xFFFFFFFFFFFFFFFFFFFF;'
+  assert.strictEqual(unescape(invalid), invalid)
+  assert.strictEqual(unescape('&#x110000;&lt;&#xD800;&#65;'), '&#x110000;<&#xD800;A')
+})
+
+test('leaves unknown and differently cased named entities untouched', function () {
+  var unknown = '&copy; &apos; &nbsp; &unknown; &AMP; &LT; &constructor; &toString;'
+  assert.strictEqual(unescape(unknown), unknown)
+  assert.strictEqual(unescape('&unknown;&amp;&copy;'), '&unknown;&&copy;')
+})
+
+test('leaves malformed or unterminated references untouched', function () {
+  var malformed = '&quot &amp &lt &gt &#39 &#; &#x; &#-1; &#+60; &#x-1; &#12a; &#xGG;'
+  assert.strictEqual(unescape(malformed), malformed)
+})
+
+test('decodes one layer per call', function () {
+  assert.strictEqual(unescape('&amp;lt; &amp;#60; &#38;quot;'), '&lt; &#60; &quot;')
+})
+
+test('preserves plain text and coerces inputs like escapeHtml', function () {
+  assert.strictEqual(unescape(''), '')
+  assert.strictEqual(unescape('plain text & Unicode \uD83D\uDE00'), 'plain text & Unicode \uD83D\uDE00')
+  assert.strictEqual(unescape(undefined), 'undefined')
+  assert.strictEqual(unescape(null), 'null')
+  assert.strictEqual(unescape(42), '42')
+  assert.strictEqual(unescape({}), '[object Object]')
+  assert.strictEqual(unescape({ toString: function () { return '&lt;' } }), '<')
+})
