     return f"+{segments}+"
 
 
+def _dokuwiki_row(separator, cell_values, colwidths, colaligns):
+    """Encode alignment with whitespace and protect literal cell separators."""
+    cells = []
+    for value, align in zip(cell_values, colaligns):
+        value = value.replace("|", "%%|%%").replace("^", "%%^%%")
+        # Keep only the padding opposite the alignment, so short cells do not
+        # accidentally become centered. DokuWiki treats decimal as right aligned.
+        if align in ("right", "decimal"):
+            cells.append("  " + value.rstrip() + " ")
+        elif align == "center":
+            cells.append("  " + value + "  ")
+        elif align == "left":
+            cells.append(" " + value.lstrip() + "  ")
+        else:
+            cells.append(" " + value.strip() + " ")
+    return separator + separator.join(cells) + separator
+
