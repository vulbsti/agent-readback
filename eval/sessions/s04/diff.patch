+def test_dokuwiki():
+    "Output: dokuwiki headers and data without horizontal rules"
+    expected = "\n".join(
+        [
+            "^ strings    ^    numbers ^",
+            "| spam       |    41.9999 |",
+            "| eggs       |   451 |",
+        ]
+    )
+    result = tabulate(_test_table, _test_table_headers, tablefmt="dokuwiki")
+    assert_equal(expected, result)
+
+
+def test_dokuwiki_headerless():
+    "Output: dokuwiki without headers"
+    expected = "| spam  |   41.9999 |\n| eggs  |  451 |"
+    assert_equal(expected, tabulate(_test_table, tablefmt="dokuwiki"))
+
+
+@mark.parametrize(
+    "align, expected",
+    [
+        ("left", "| x     |\n| long  |"),
+        ("right", "|     x |\n|  long |"),
+        ("center", "|   x    |\n|  long  |"),
+        ("decimal", "|     x |\n|  long |"),
+        (None, "| x |\n| long |"),
+    ],
+)
+def test_dokuwiki_alignment(align, expected):
+    "Output: dokuwiki alignment holds for short and full-width cells"
+    result = tabulate([["x"], ["long"]], tablefmt="dokuwiki", colalign=(align,))
+    assert_equal(expected, result)
+
+
+def test_dokuwiki_header_alignment():
+    "Output: dokuwiki headers can have their own alignment"
+    result = tabulate(
+        [["apple", 3]], ["name", "qty"], tablefmt="dokuwiki", headersglobalalign="center"
+    )
+    expected = "^   name   ^   qty   ^\n| apple   |      3 |"
+    assert_equal(expected, result)
+
+
+def test_dokuwiki_escape_separators():
+    "Output: dokuwiki protects both separators in headers and data"
+    result = tabulate([["a|b", "c^d"], ["|^", "^|"]], ["h|", "h^"], tablefmt="dokuwiki")
+    expected = "\n".join(
+        [
+            "^ h%%|%%    ^ h%%^%%    ^",
+            "| a%%|%%b   | c%%^%%d   |",
+            "| %%|%%%%^%%    | %%^%%%%|%%    |",
+        ]
+    )
+    assert_equal(expected, result)
+
+
+def test_dokuwiki_empty_cells():
+    "Output: dokuwiki empty cells retain their separators"
+    result = tabulate([[None, ""], ["", None]], ["a", "b"], tablefmt="dokuwiki")
+    assert_equal("^ a    ^ b    ^\n|   |   |\n|   |   |", result)
+
+
+def test_dokuwiki_empty_table():
+    "Output: dokuwiki handles empty tables with or without headers"
+    assert_equal("", tabulate([], tablefmt="dokuwiki"))
+    assert_equal("^ name    ^ qty    ^", tabulate([], ["name", "qty"], tablefmt="dokuwiki"))
+
+
+def test_dokuwiki_registered():
+    "API: dokuwiki is listed as a supported table format"
+    assert "dokuwiki" in tabulate_formats
+
+
