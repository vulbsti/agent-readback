@@ -0,0 +1,143 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import prettyBytes from './index.js';
+
+test('spec examples with maximumFractionDigits', () => {
+	assert.equal(prettyBytes(1999, {maximumFractionDigits: 1, roundingMode: 'round'}), '2 kB');
+	assert.equal(prettyBytes(1999, {maximumFractionDigits: 1, roundingMode: 'floor'}), '1.9 kB');
+	assert.equal(prettyBytes(1999, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '2 kB');
+	assert.equal(prettyBytes(1999n, {maximumFractionDigits: 1, roundingMode: 'round'}), '2 kB');
+	assert.equal(prettyBytes(1999n, {maximumFractionDigits: 1, roundingMode: 'floor'}), '1.9 kB');
+});
+
+test('omitted roundingMode keeps existing behavior', () => {
+	// Fraction digit options keep truncating.
+	assert.equal(prettyBytes(1999, {maximumFractionDigits: 1}), '1.9 kB');
+	assert.equal(prettyBytes(59_952_784, {maximumFractionDigits: 1}), '59.9 MB');
+	// The 3 significant digit default keeps rounding, and explicit `round` matches it.
+	for (const value of [1337, 1005, 1125, 999_500, 1999, 0.000_123_45, 123_456_789]) {
+		assert.equal(prettyBytes(value, {roundingMode: 'round'}), prettyBytes(value));
+	}
+
+	assert.equal(prettyBytes(1337, {roundingMode: undefined}), '1.34 kB');
+});
+
+test('round, floor and ceil with fraction digits', () => {
+	assert.equal(prettyBytes(1150, {maximumFractionDigits: 1, roundingMode: 'round'}), '1.2 kB');
+	assert.equal(prettyBytes(1149, {maximumFractionDigits: 1, roundingMode: 'round'}), '1.1 kB');
+	assert.equal(prettyBytes(1101, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '1.2 kB');
+	assert.equal(prettyBytes(1100, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '1.1 kB');
+	assert.equal(prettyBytes(1199, {maximumFractionDigits: 1, roundingMode: 'floor'}), '1.1 kB');
+	assert.equal(prettyBytes(1337, {minimumFractionDigits: 2, maximumFractionDigits: 2, roundingMode: 'round'}), '1.34 kB');
+	assert.equal(prettyBytes(1337, {minimumFractionDigits: 2, maximumFractionDigits: 2, roundingMode: 'floor'}), '1.33 kB');
+	assert.equal(prettyBytes(1331, {minimumFractionDigits: 2, maximumFractionDigits: 2, roundingMode: 'ceil'}), '1.34 kB');
+	assert.equal(prettyBytes(1999, {minimumFractionDigits: 1, maximumFractionDigits: 1, roundingMode: 'round'}), '2.0 kB');
+	assert.equal(prettyBytes(1999, {minimumFractionDigits: 3, roundingMode: 'ceil'}), '1.999 kB');
+	assert.equal(prettyBytes(1999, {maximumFractionDigits: 0, roundingMode: 'floor'}), '1 kB');
+	assert.equal(prettyBytes(1001, {maximumFractionDigits: 0, roundingMode: 'ceil'}), '2 kB');
+	assert.equal(prettyBytes(1500, {maximumFractionDigits: 0, roundingMode: 'round'}), '2 kB');
+	assert.equal(prettyBytes(1126, {binary: true, maximumFractionDigits: 2, roundingMode: 'ceil'}), '1.1 KiB');
+	assert.equal(prettyBytes(1126, {binary: true, maximumFractionDigits: 2, roundingMode: 'floor'}), '1.09 KiB');
+});
+
+test('round, floor and ceil with the significant digit default', () => {
+	assert.equal(prettyBytes(1999, {roundingMode: 'floor'}), '1.99 kB');
+	assert.equal(prettyBytes(1999, {roundingMode: 'ceil'}), '2 kB');
+	assert.equal(prettyBytes(1001, {roundingMode: 'ceil'}), '1.01 kB');
+	assert.equal(prettyBytes(1001, {roundingMode: 'floor'}), '1 kB');
+	assert.equal(prettyBytes(1337, {roundingMode: 'floor'}), '1.33 kB');
+	assert.equal(prettyBytes(123_456_789, {roundingMode: 'ceil'}), '124 MB');
+	assert.equal(prettyBytes(0.000_123_45, {roundingMode: 'ceil'}), '0.000124 B');
+	assert.equal(prettyBytes(0.000_123_45, {roundingMode: 'floor'}), '0.000123 B');
+});
+
+test('rounding up carries onto the next unit', () => {
+	assert.equal(prettyBytes(999_960, {maximumFractionDigits: 1, roundingMode: 'round'}), '1 MB');
+	assert.equal(prettyBytes(999_960, {minimumFractionDigits: 1, roundingMode: 'round'}), '999.96 kB');
+	assert.equal(prettyBytes(999_960, {minimumFractionDigits: 1, maximumFractionDigits: 1, roundingMode: 'round'}), '1.0 MB');
+	assert.equal(prettyBytes(999_901, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '1 MB');
+	assert.equal(prettyBytes(999_999, {maximumFractionDigits: 1, roundingMode: 'floor'}), '999.9 kB');
+	assert.equal(prettyBytes(999_100, {roundingMode: 'ceil'}), '1 MB');
+	assert.equal(prettyBytes(999_999, {roundingMode: 'floor'}), '999 kB');
+	assert.equal(prettyBytes(1_048_575, {binary: true, maximumFractionDigits: 1, roundingMode: 'round'}), '1 MiB');
+	assert.equal(prettyBytes(1_048_575, {binary: true, maximumFractionDigits: 1, roundingMode: 'floor'}), '1023.9 KiB');
+	// The largest unit has nowhere to carry to.
+	assert.equal(prettyBytes(999.96e24, {maximumFractionDigits: 1, roundingMode: 'round'}), '1000 YB');
+});
+
+test('negative numbers: floor moves toward negative infinity, ceil toward positive infinity', () => {
+	assert.equal(prettyBytes(-1999, {maximumFractionDigits: 1, roundingMode: 'floor'}), '-2 kB');
+	assert.equal(prettyBytes(-1999, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '-1.9 kB');
+	assert.equal(prettyBytes(-1999, {maximumFractionDigits: 1, roundingMode: 'round'}), '-2 kB');
+	assert.equal(prettyBytes(-1150, {maximumFractionDigits: 1, roundingMode: 'round'}), '-1.2 kB');
+	assert.equal(prettyBytes(-1999n, {maximumFractionDigits: 1, roundingMode: 'floor'}), '-2 kB');
+	assert.equal(prettyBytes(-1999n, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '-1.9 kB');
+	assert.equal(prettyBytes(-1001, {roundingMode: 'floor'}), '-1.01 kB');
+	assert.equal(prettyBytes(-1001, {roundingMode: 'ceil'}), '-1 kB');
+	assert.equal(prettyBytes(-999_901, {maximumFractionDigits: 1, roundingMode: 'floor'}), '-1 MB');
+	// floor(x) === -ceil(-x)
+	for (const value of [1, 1001, 1337, 1999, 54_321, 999_901]) {
+		for (const maximumFractionDigits of [undefined, 0, 1, 2]) {
+			const floor = prettyBytes(-value, {maximumFractionDigits, roundingMode: 'floor'});
+			const ceil = prettyBytes(value, {maximumFractionDigits, roundingMode: 'ceil'});
+			assert.equal(floor, `-${ceil}`);
+		}
+	}
+});
+
+test('signed option', () => {
+	assert.equal(prettyBytes(1999, {signed: true, maximumFractionDigits: 1, roundingMode: 'floor'}), '+1.9 kB');
+	assert.equal(prettyBytes(1999, {signed: true, maximumFractionDigits: 1, roundingMode: 'ceil'}), '+2 kB');
+	assert.equal(prettyBytes(-1999, {signed: true, maximumFractionDigits: 1, roundingMode: 'floor'}), '-2 kB');
+	assert.equal(prettyBytes(-1999, {signed: true, maximumFractionDigits: 1, roundingMode: 'ceil'}), '-1.9 kB');
+	assert.equal(prettyBytes(0, {signed: true, minimumFractionDigits: 1, roundingMode: 'ceil'}), ' 0.0 B');
+	assert.equal(prettyBytes(-0, {signed: true, roundingMode: 'floor'}), ' 0 B');
+});
+
+test('locale option', () => {
+	assert.equal(prettyBytes(1999, {locale: 'de', maximumFractionDigits: 1, roundingMode: 'floor'}), '1,9 kB');
+	assert.equal(prettyBytes(1999, {locale: 'de', maximumFractionDigits: 1, roundingMode: 'round'}), '2 kB');
+	assert.equal(prettyBytes(1337, {locale: 'de', roundingMode: 'floor'}), '1,33 kB');
+	assert.equal(prettyBytes(-1337, {locale: 'de', roundingMode: 'floor'}), '-1,34 kB');
+	assert.equal(prettyBytes(1_048_575, {locale: 'en', binary: true, maximumFractionDigits: 1, roundingMode: 'floor'}), '1,023.9 KiB');
+	assert.equal(prettyBytes(1_048_575, {locale: 'en', binary: true, maximumFractionDigits: 1, roundingMode: 'round'}), '1 MiB');
+	assert.equal(prettyBytes(1331, {locale: ['de', 'en'], minimumFractionDigits: 2, maximumFractionDigits: 2, roundingMode: 'ceil'}), '1,34 kB');
+});
+
+test('bigint past the number range', () => {
+	const scale = 10n ** 24n;
+	const value = (10n ** 400n) + (scale * 19n / 20n); // ...0.95 YB
+	const whole = `1${'0'.repeat(376)}`;
+	const wholePlusOne = `1${'0'.repeat(375)}1`;
+	assert.equal(prettyBytes(value), `${whole} YB`);
+	assert.equal(prettyBytes(value, {roundingMode: 'round'}), `${wholePlusOne} YB`);
+	assert.equal(prettyBytes(value, {roundingMode: 'floor'}), `${whole} YB`);
+	assert.equal(prettyBytes(value, {roundingMode: 'ceil'}), `${wholePlusOne} YB`);
+	assert.equal(prettyBytes(value, {maximumFractionDigits: 1}), `${whole}.9 YB`);
+	assert.equal(prettyBytes(value, {maximumFractionDigits: 1, roundingMode: 'round'}), `${wholePlusOne} YB`);
+	assert.equal(prettyBytes(value, {minimumFractionDigits: 1, maximumFractionDigits: 1, roundingMode: 'round'}), `${wholePlusOne}.0 YB`);
+	assert.equal(prettyBytes(value + 1n, {maximumFractionDigits: 2, roundingMode: 'ceil'}), `${whole}.96 YB`);
+	assert.equal(prettyBytes(-value, {maximumFractionDigits: 1, roundingMode: 'floor'}), `-${wholePlusOne} YB`);
+	assert.equal(prettyBytes(-value, {maximumFractionDigits: 1, roundingMode: 'ceil'}), `-${whole}.9 YB`);
+	assert.equal(prettyBytes(10n ** 400n, {maximumFractionDigits: 2, roundingMode: 'ceil'}), `${whole} YB`);
+});
+
+test('documented tie behavior and rounding to zero', () => {
+	assert.equal(prettyBytes(1005, {roundingMode: 'round'}), '1 kB');
+	assert.equal(prettyBytes(1005, {maximumFractionDigits: 2, roundingMode: 'round'}), '1.01 kB');
+	assert.equal(prettyBytes(-1005, {maximumFractionDigits: 2, roundingMode: 'round'}), '-1.01 kB');
+	assert.equal(prettyBytes(-0.04, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '-0 B');
+	assert.equal(prettyBytes(-0.04, {maximumFractionDigits: 1, roundingMode: 'floor'}), '-0.1 B');
+	assert.equal(prettyBytes(0.04, {maximumFractionDigits: 1, roundingMode: 'ceil'}), '0.1 B');
+});
+
+test('rejects invalid roundingMode', () => {
+	for (const roundingMode of ['trunc', 'halfExpand', 'ROUND', '', null, 1, true]) {
+		assert.throws(() => prettyBytes(1337, {roundingMode}), {
+			name: 'TypeError',
+			message: /Expected roundingMode to be one of 'round', 'floor' or 'ceil'/,
+		});
+	}
+
+	assert.throws(() => prettyBytes(0, {signed: true, roundingMode: 'up'}), TypeError);
+});
